<?xml version="1.0"?>
<robot name="robot_m1_3dof">
  <link name="base_link"><visual><origin xyz="0 0 0.075"/><geometry><cylinder radius="0.06" length="0.15"/></geometry></visual></link>
  <link name="shoulder_hub"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.04" length="0.06"/></geometry></visual></link>
  <joint name="joint_1" type="revolute"><parent link="base_link"/><child link="shoulder_hub"/><origin xyz="0 0 0.15"/><axis xyz="0 0 1"/><limit lower="-3.1416" upper="3.1416" effort="50" velocity="3.0"/></joint>
  <link name="link_2"><visual><origin xyz="0.125 0 0"/><geometry><box size="0.25 0.035 0.035"/></geometry></visual></link>
  <joint name="joint_2" type="revolute"><parent link="shoulder_hub"/><child link="link_2"/><origin xyz="0 0 0"/><axis xyz="0 -1 0"/><limit lower="-1.5708" upper="2.356" effort="50" velocity="3.0"/></joint>
  <link name="link_3"><visual><origin xyz="0.1 0 0"/><geometry><box size="0.2 0.028 0.028"/></geometry></visual></link>
  <joint name="joint_3" type="revolute"><parent link="link_2"/><child link="link_3"/><origin xyz="0.25 0 0"/><axis xyz="0 -1 0"/><limit lower="-2.6" upper="2.6" effort="50" velocity="3.0"/></joint>
  <link name="end_effector"><visual><geometry><sphere radius="0.022"/></geometry></visual></link>
  <joint name="ee_fixed" type="fixed"><parent link="link_3"/><child link="end_effector"/><origin xyz="0.2 0 0"/></joint>
</robot>
